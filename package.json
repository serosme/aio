{
  "name": "aio",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "electron/main.ts",
  "scripts": {
    "typecheck": "nuxt typecheck",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "ncu": "npx --yes npm-check-updates",
    "ncuu": "npx --yes npm-check-updates --upgrade",
    "dev": "cross-env DEV_PORT=3000 concurrently -n \"nuxt,electron\" -k \"nuxt dev\" \"node electron/wait.mjs && cross-env NODE_ENV=dev electron .\"",
    "preview": "nuxt build && electron .",
    "build": "nuxt build && electron-builder",
    "release": "nuxt build && electron-builder && node release.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.125",
    "@napi-rs/clipboard": "1.1.4",
    "@nuxt/ui": "4.10.0",
    "@vueuse/core": "14.4.0",
    "conf": "15.1.0",
    "js-yaml": "5.2.3",
    "nuxt": "4.4.8",
    "pinyin-pro": "3.29.3",
    "taglib-wasm": "1.8.3",
    "tailwindcss": "4.3.3",
    "uiohook-napi": "1.5.5",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.7",
    "eslint": "10.8.1",
    "eslint-plugin-format": "2.0.1",
    "vue-tsc": "3.3.11"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.5.6": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "uiohook-napi@1.5.5": true
  }
}
